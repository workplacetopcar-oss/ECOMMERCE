{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gestion-reclamos-storage",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gestion-reclamos",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "gestion-reclamos-privado" }
  ]
}
